# ─── Supabase ────────────────────────────────────────────────────────────────
# Use the SERVICE ROLE key (not the anon key) — required for server-side inserts
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=                        # Used for text-embedding-3-small
ANTHROPIC_API_KEY=                     # Used for claude-sonnet-4-6 and claude-haiku-4-5

# ─── GoHighLevel ─────────────────────────────────────────────────────────────
# Private Integration Token — needs scopes:
#   conversations/message.write  contacts/tags.write  contacts/workflow.write
GHL_API_KEY=
GHL_WEBHOOK_SECRET=                    # Set in GHL → Settings → Webhooks
GHL_LOCATION_ID=                       # Sub-account location ID
GHL_BOT_USER_ID=                       # GHL userId of the bot's API user (anti-loop filter)

# ─── GHL Workflow IDs ────────────────────────────────────────────────────────
# Find these in GHL → Automations → Workflows → (workflow) → URL bar
GHL_WORKFLOW_BOOK_CONSULTATION=
GHL_WORKFLOW_GENERAL_INQUIRY=
GHL_WORKFLOW_HOT_LEAD=
GHL_WORKFLOW_UNANSWERED=

# ─── RAG Tuning ──────────────────────────────────────────────────────────────
# Cosine similarity threshold (0.0–1.0). Lower = more permissive retrieval.
# Start at 0.75 and adjust based on conversation_log data.
SIMILARITY_THRESHOLD=0.75
MAX_RETRIEVAL_CHUNKS=5
MAX_CONTEXT_CHARS=8000

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
